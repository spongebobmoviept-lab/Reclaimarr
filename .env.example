# Reclaimarr — optional settings. To use them: cp .env.example .env, then
# uncomment what you need. Never commit your real `.env`.
#
# Everything else (Plex, Radarr, Tautulli, Discord, your admin login) is
# configured through the setup wizard in your browser after you start the
# container: http://<this-machine's-ip>:8585
#
# These are infrastructure defaults. Only uncomment/change if you have a
# specific reason to.

# APP_PORT=8585
# DRY_RUN=false

# Container path(s) Reclaimarr may rename/move/delete files under — the same
# path(s) Radarr uses for its movie root folders, comma-separated. Must match
# the volume mounts in docker-compose.yml. Default: /media2
# MEDIA_ROOTS=/media2
# MEDIA_ROOTS=/media2,/media4

# Optional qBittorrent boost: force-start + top-priority a 4K upgrade's
# download while someone is waiting for it. Leave QBIT_URL empty to skip.
# QBIT_URL=http://qbittorrent:8080
# QBIT_USERNAME=admin
# QBIT_PASSWORD=
# Optional: JSON file listing the torrent hashes Reclaimarr force-started, so
# another queue-management tool can leave them alone. Off when empty.
# QBIT_ACTIVE_HASHES_FILE=/shared/qbit/reclaimarr_active_hashes.json

# Discord (the webhook itself is set in the setup wizard)
# DIGEST_HOUR_UTC=13
# DISCORD_USERNAME=Reclaimarr
# DISCORD_STARTUP_NOTICE=false

# Upgrade tuning
# UPGRADE_RETRY_COOLDOWN_MINUTES=30
# UPGRADE_NO_RELEASE_COOLDOWN_HOURS=12

# Library integrity check
# LIBRARY_INTEGRITY_CHECK_INTERVAL_HOURS=6
# INTEGRITY_SANITY_LIMIT=8
# INTEGRITY_STARTUP_DELAY_SECONDS=180

# Optional: run as a different uid:gid (must own ./data and your movies)
# PUID=1000
# PGID=1000
